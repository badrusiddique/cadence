{
  "name": "cadence-insights",
  "displayName": "Cadence: Agent Engineering Insights",
  "description": "Local insights for AI coding assistants. Watch sessions, measure output, fix habits. No telemetry. Logs stay read-only.",
  "version": "1.2.2",
  "publisher": "badrusiddique",
  "author": {
    "name": "Badru Siddique"
  },
  "license": "MIT",
  "icon": "assets/icon-256.png",
  "galleryBanner": {
    "color": "#141414",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/badrusiddique/cadence.git"
  },
  "bugs": {
    "url": "https://github.com/badrusiddique/cadence/issues"
  },
  "homepage": "https://github.com/badrusiddique/cadence#readme",
  "bin": {
    "cadence": "scripts/cadence.mjs",
    "cadence-insights": "scripts/cadence.mjs"
  },
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Visualization",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "copilot",
    "claude",
    "codex",
    "opencode",
    "cursor",
    "analytics",
    "productivity",
    "agentic",
    "cadence"
  ],
  "activationEvents": [
    "onCommand:cadence.open",
    "onCommand:cadence.reload",
    "onCommand:cadence.exportSummary",
    "onCommand:cadence.reviewSignals",
    "onView:cadence.overview"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces, project-level Cadence signals under .cadence/ are not loaded. Built-in and personal signals still work."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "cadence.open",
        "title": "Cadence: Open Overview",
        "icon": "$(pulse)"
      },
      {
        "command": "cadence.reload",
        "title": "Cadence: Reload Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "cadence.exportSummary",
        "title": "Cadence: Export Snapshot",
        "icon": "$(export)"
      },
      {
        "command": "cadence.reviewSignals",
        "title": "Cadence: Review Local Signals",
        "icon": "$(shield)"
      },
      {
        "command": "cadence.showOutput",
        "title": "Cadence: Show Output Channel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cadence",
          "title": "Cadence",
          "icon": "assets/activity-bar.svg"
        }
      ]
    },
    "views": {
      "cadence": [
        {
          "id": "cadence.overview",
          "name": "Overview",
          "type": "webview"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "cadence.coach",
        "fullName": "Cadence",
        "name": "cadence",
        "description": "Ask about your AI coding cadence: usage summary, habits, flow, and tool comparison.",
        "isSticky": true,
        "commands": [
          {
            "name": "summary",
            "description": "Summarize recent AI coding activity"
          },
          {
            "name": "habits",
            "description": "Surface habit findings and how to improve"
          },
          {
            "name": "compare",
            "description": "Compare harnesses side by side"
          },
          {
            "name": "flow",
            "description": "Review flow and focus signals"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "cadence_summary",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Usage Summary",
        "modelDescription": "High-level summary of AI coding assistant usage: sessions, recommendations, top habits.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string",
              "description": "ISO date YYYY-MM-DD"
            },
            "toDate": {
              "type": "string",
              "description": "ISO date YYYY-MM-DD"
            },
            "workspaceId": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "cadence_activity",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Daily Activity",
        "modelDescription": "Daily activity: requests, LOC, sessions, harness breakdown.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string"
            },
            "toDate": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "cadence_budget",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Budget Estimates",
        "modelDescription": "Local AI credit/token estimates with model breakdown. Not billing data.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string"
            },
            "toDate": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "cadence_throughput",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Throughput",
        "modelDescription": "AI vs user LOC, language and workspace distribution.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string"
            },
            "toDate": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "cadence_flow",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Flow",
        "modelDescription": "Flow scores, best hours, follow-up latency, continuity.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string"
            },
            "toDate": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "cadence_habits",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Habits",
        "modelDescription": "Detected habit findings with severity and recommendations.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string"
            },
            "toDate": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "cadence_compare",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Harness Compare",
        "modelDescription": "Side-by-side harness comparison: sessions, requests, LOC, cancel rates.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string"
            },
            "toDate": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "cadence_patterns",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Work Patterns",
        "modelDescription": "Work-hours heatmap, late-night/weekend balance, calendar intensity, and project mix.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string"
            },
            "toDate": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "cadence_insights",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Insights Bundle",
        "modelDescription": "Combined wellbeing, curiosity, context, and flow insights for coaching agents.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string"
            },
            "toDate": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "cadence_wellbeing",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Wellbeing",
        "modelDescription": "Late-night load, weekend ratio, flow score, and balance signals.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string"
            },
            "toDate": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "cadence_sessions",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Sessions",
        "modelDescription": "Timeline of sessions, or a single session detail when sessionId is provided.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "description": "Optional session id for detail view"
            },
            "fromDate": {
              "type": "string"
            },
            "toDate": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "cadence_context",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Context Health",
        "modelDescription": "Context quality and management checks: files, instructions, skills, compaction, long prompts.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string"
            },
            "toDate": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "cadence_curiosity",
        "tags": [
          "cadence"
        ],
        "displayName": "Cadence: Curiosity",
        "modelDescription": "Inquiry vs action balance, research channels, and question samples.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string"
            },
            "toDate": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Cadence",
      "properties": {
        "cadence.demoMode": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in sample data for demos and screenshots. Off by default. Real installs stay empty until local AI logs are found."
        },
        "cadence.budgetSku": {
          "type": "string",
          "enum": [
            "pro",
            "pro-plus",
            "business",
            "enterprise",
            "custom"
          ],
          "default": "pro",
          "description": "Assumed AI credit SKU for Budget estimates. Estimates only, not billing."
        },
        "cadence.customBudgetCredits": {
          "type": "number",
          "default": 1000,
          "description": "Custom monthly credit budget when budgetSku is custom."
        },
        "cadence.redactSensitive": {
          "type": "boolean",
          "default": false,
          "description": "When true, exports and share snapshots omit prompt excerpts and habit example text (enterprise sharing)."
        },
        "cadence.offlineUi": {
          "type": "boolean",
          "default": true,
          "description": "Air-gapped webview CSP: block third-party font/CDN requests (recommended for enterprise)."
        },
        "cadence.maxSessions": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 50000,
          "description": "Hard cap on sessions loaded into memory per reload (host safety)."
        },
        "cadence.maxFilesPerWalk": {
          "type": "number",
          "default": 8000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Hard cap on files scanned per harness directory walk."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "package": "npm run build && vsce package --no-dependencies",
    "preview": "node scripts/preview-server.mjs",
    "cli": "node scripts/cadence.mjs",
    "mcp": "node scripts/cadence.mjs mcp",
    "setup:mcp": "node scripts/setup-mcp.mjs",
    "gen:signals": "node scripts/gen-signals.mjs",
    "gen:fixtures": "node scripts/gen-fixtures.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.8",
    "htm": "^3.1.1",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.1",
    "eslint": "^9.22.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.9"
  }
}
